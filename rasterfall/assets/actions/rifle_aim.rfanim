endtrack
track left_upper_arm linear
key 0 0 0 -70
key 1000 0 0 -70
endtrack
track left_forearm linear
key 0 0 -80 0
key 1000 0 -80 0
endtrack
track left_hand linear
key 0 0 0 0
key 1000 0 0 0
endtrack
track right_upper_arm linear
key 0 -12 -12 90
key 1000 -12 -12 90
endtrack
track right_forearm linear
key 0 -56 10 139
key 1000 -56 10 139
endtrack
track right_hand linear
key 0 -153 -13 35
key 1000 -153 -13 35
endtrack
track left_shoulder linear
