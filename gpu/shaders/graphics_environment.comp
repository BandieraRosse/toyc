#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=64) in;
#include "lighting.glsl"
#define RF_SKY_DIRECTION_ONLY
#include "sky.glsl"
layout(push_constant) uniform Phase { uint phase; } update;
layout(set=1,binding=14,std430) buffer SkyEnvironment { vec4 data[]; } environment_output;
shared vec3 lobes[6][64];
vec3 direction_at(uint index) {
    float y=(float(index/32u)+0.5)/16.0,phi=((float(index%32u)+0.5)/32.0-0.5)*6.28318530718;
    return vec3(sqrt(1.0-y*y)*cos(phi),y,sqrt(1.0-y*y)*sin(phi));
}
void main() {
    uint lane=gl_LocalInvocationID.x;
    if(update.phase==0u) {
        uint i=gl_GlobalInvocationID.x;
        if(i<512u)environment_output.data[7u+i]=vec4(sky_direction(direction_at(i),40,true).rgb,0);
        return;
    }
    for(uint lobe=0u;lobe<6u;++lobe) {
        vec3 value=vec3(0);
        for(uint i=lane;i<512u;i+=64u) {
            vec3 d=direction_at(i);
            value+=environment_output.data[7u+i].rgb*max(0.0,d[lobe/2u]*((lobe&1u)==0u?1.0:-1.0))*(2.0/512.0);
        }
        lobes[lobe][lane]=value;
    }
    barrier();
    for(uint size=32u;size>0u;size/=2u) {
        if(lane<size)for(uint lobe=0u;lobe<6u;++lobe)lobes[lobe][lane]+=lobes[lobe][lane+size];
        barrier();
    }
    float horizontal=3.14159265359*dot(lobes[2][0],vec3(0.2126,0.7152,0.0722));
    float scale=horizontal>1e-8?lighting.daylight.x/horizontal:0.0;
    if(lane<6u)environment_output.data[1u+lane]=vec4(lobes[lane][0]*scale,0);
    if(lane==0u)environment_output.data[0]=vec4(scale,0,0,0);
}
