#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#ifndef RF_RASTER_LOCAL_SIZE
#define RF_RASTER_LOCAL_SIZE 16
#endif

layout(local_size_x = RF_RASTER_LOCAL_SIZE,
       local_size_y = RF_RASTER_LOCAL_SIZE,
       local_size_z = 1) in;

/* GPU-4 is a frozen little-endian byte ABI.  Read it as 32-bit words so the
 * shader never depends on a GLSL structure layout matching a C structure. */
layout(set = 0, binding = 0, std430) readonly buffer CommandStream {
    uint words[];
} stream;
layout(set = 0, binding = 1, std430) writeonly buffer ColorBuffer {
    uint pixels[];
} color_out;
layout(set = 0, binding = 2, std430) writeonly buffer DepthBuffer {
    int values[];
} depth_out;
layout(set = 0, binding = 3, std430) readonly buffer TileOffsets {
    uint offsets[];
} tile_offsets;
layout(set = 0, binding = 4, std430) readonly buffer TileCommandIndices {
    uint indices[];
} tile_commands;
layout(set = 0, binding = 5, std430) readonly buffer TextureDescriptors {
    uint words[];
} texture_descs;
layout(set = 0, binding = 6, std430) readonly buffer TextureTexels {
    uint words[];
} texture_texels;

const uint HEADER_WORDS = 8u;
const uint COMMAND_WORDS = 24u;
const uint CMD_CLEAR_COLOR = 1u;
const uint CMD_CLEAR_DEPTH = 2u;
const uint CMD_FLAT_TRIANGLE = 3u;
const uint CMD_VERTEX_LIT_TRIANGLE = 4u;
const uint CMD_TEXTURED_TRIANGLE = 5u;
const uint CMD_SKY = 6u;
const uint FLAG_TEXTURE_REPEAT = 16u;

uint texture_byte(uint offset)
{
    return (texture_texels.words[offset >> 2u] >> ((offset & 3u) * 8u)) & 255u;
}

uint sample_texture(uint handle, int64_t u, int64_t v, bool repeat)
{
    uint d = (handle - 1u) * 6u;
    uint offset = texture_descs.words[d], width = texture_descs.words[d + 1u];
    uint height = texture_descs.words[d + 2u], stride = texture_descs.words[d + 3u];
    uint format = texture_descs.words[d + 4u];
    if (repeat) {
        u &= int64_t(65535); v &= int64_t(65535);
    } else {
        u = clamp(u, int64_t(0), int64_t(65535));
        v = clamp(v, int64_t(0), int64_t(65535));
    }
    uint tx = uint((u * int64_t(width)) / int64_t(65536));
    uint ty = uint((v * int64_t(height)) / int64_t(65536));
    uint channels = format == 2u ? 4u : 3u;
    uint at = offset + ty * stride + tx * channels;
    return 0xff000000u | (texture_byte(at) << 16) |
           (texture_byte(at + 1u) << 8) | texture_byte(at + 2u);
}

int64_t s64(uint low, uint high)
{
    uint64_t bits = uint64_t(low) | (uint64_t(high) << 32);
    return int64_t(bits);
}

int64_t edge(int ax, int ay, int bx, int by, int px, int py)
{
    return (int64_t(px) - int64_t(ax)) * (int64_t(by) - int64_t(ay)) -
           (int64_t(py) - int64_t(ay)) * (int64_t(bx) - int64_t(ax));
}

uint shade(uint packed, int light, int fog)
{
    int r = int((packed >> 16) & 255u);
    int g = int((packed >> 8) & 255u);
    int b = int(packed & 255u);
    light = clamp(light, 0, 384);
    r = min(r * light / 256, 255);
    g = min(g * light / 256, 255);
    b = min(b * light / 256, 255);
    fog = clamp(fog, 0, 256);
    r = (r * (256 - fog) + 28 * fog) / 256;
    g = (g * (256 - fog) + 33 * fog) / 256;
    b = (b * (256 - fog) + 40 * fog) / 256;
    return 0xff000000u | (uint(r) << 16) | (uint(g) << 8) | uint(b);
}

uint mix_color(uint from, uint to, int num, int den)
{
    uint r=(((from>>16)&255u)*uint(num)+((to>>16)&255u)*uint(den-num))/uint(den);
    uint g=(((from>>8)&255u)*uint(num)+((to>>8)&255u)*uint(den-num))/uint(den);
    uint b=((from&255u)*uint(num)+(to&255u)*uint(den-num))/uint(den);
    return 0xff000000u|(r<<16)|(g<<8)|b;
}

uint sky_color(uint base, uint x, uint y, uint width, uint height)
{
    int pitch_sy=int(stream.words[base+6u]),pitch_cy=abs(int(stream.words[base+7u]));
    int focal=int(width)*3/4,horizon=int(height)/2;
    if(pitch_cy>=64)horizon+=clamp(focal*pitch_sy/pitch_cy,-2*int(height),2*int(height));
    else horizon=pitch_sy>0?-int(height):2*int(height);
    uint zenith=stream.words[base+8u],horizon_color=stream.words[base+9u];
    if(int(y)>=max(horizon,0))return stream.words[base+10u]|0xff000000u;
    int sky_bottom=min(horizon,int(height)),band_h=sky_bottom/8+1;
    int band=clamp(int(y)/band_h,0,7);
    uint color=mix_color(zenith,horizon_color,7-band,8);
    const int dx[3]=int[3](340,-872,-488),dy[3]=int[3](248,172,380),dz[3]=int[3](-934,-512,-816);
    const int scales[3]=int[3](16,12,10);
    int direction_sy=int(stream.words[base+4u]),direction_cy=int(stream.words[base+5u]);
    for(int i=0;i<3;i++){
        int vx=(dx[i]*direction_cy-dz[i]*direction_sy)/1024;
        int vz0=(dx[i]*direction_sy+dz[i]*direction_cy)/1024;
        int vy2=(dy[i]*int(stream.words[base+7u])-vz0*pitch_sy)/1024;
        int vz2=(dy[i]*pitch_sy+vz0*int(stream.words[base+7u]))/1024;
        if(vz2<=64)continue;
        int cx=int(width)/2+vx*focal/vz2,cy=int(height)/2-vy2*focal/vz2;
        int unit=max(scales[i]/4,2),px=int(x),py=int(y);
        if(px>=cx-unit*7&&px<cx+unit*7&&py>=cy+unit*2&&py<cy+unit*3)color=0xffb9d9ecu;
        if(px>=cx-unit*6&&px<cx+unit*6&&py>=cy&&py<cy+unit*3)color=0xffeaf7ffu;
        if(px>=cx-unit*3&&px<cx+unit*3&&py>=cy-unit*2&&py<cy)color=0xffffffffu;
        if(((px>=cx-unit*5&&px<cx-unit*3)||(px>=cx+unit*3&&px<cx+unit*5))&&py>=cy-unit&&py<cy)color=0xffffffffu;
    }
    return color;
}

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint width = stream.words[5];
    uint height = stream.words[6];
    if (x >= width || y >= height)
        return;

    uint color = 0xff000000u;
    int depth = 0;
    uint tiles_x = (width + RF_RASTER_LOCAL_SIZE - 1u) / RF_RASTER_LOCAL_SIZE;
    uint tile_id = gl_WorkGroupID.y * tiles_x + gl_WorkGroupID.x;
    uint list_begin = tile_offsets.offsets[tile_id];
    uint list_end = tile_offsets.offsets[tile_id + 1u];
    for (uint list_index = list_begin; list_index < list_end; ++list_index) {
        uint command_index = tile_commands.indices[list_index];
        uint base = HEADER_WORDS + command_index * COMMAND_WORDS;
        uint kind = stream.words[base];
        if (kind == CMD_SKY) {
            color = sky_color(base,x,y,width,height);
        } else if (kind == CMD_CLEAR_COLOR) {
            color = stream.words[base + 4u] | 0xff000000u;
        } else if (kind == CMD_CLEAR_DEPTH) {
            depth = int(stream.words[base + 4u]);
        } else if (kind == CMD_FLAT_TRIANGLE ||
                   kind == CMD_VERTEX_LIT_TRIANGLE ||
                   kind == CMD_TEXTURED_TRIANGLE) {
            int ax = int(stream.words[base + 6u]);
            int ay = int(stream.words[base + 7u]);
            int bx = int(stream.words[base + 9u]);
            int by = int(stream.words[base + 10u]);
            int cx = int(stream.words[base + 12u]);
            int cy = int(stream.words[base + 13u]);
            int minx = kind == CMD_TEXTURED_TRIANGLE ? min(ax, min(bx, cx)) : int(stream.words[base + 15u]);
            int maxx = kind == CMD_TEXTURED_TRIANGLE ? max(ax, max(bx, cx)) + 1 : int(stream.words[base + 16u]);
            int miny = kind == CMD_TEXTURED_TRIANGLE ? min(ay, min(by, cy)) : int(stream.words[base + 17u]);
            int maxy = kind == CMD_TEXTURED_TRIANGLE ? max(ay, max(by, cy)) + 1 : int(stream.words[base + 18u]);
            if (int(x) < minx || int(x) > maxx ||
                int(y) < miny || int(y) > maxy)
                continue;
            int64_t area = s64(stream.words[base + 4u],
                               stream.words[base + 5u]);
            /* Valid GPU-4 streams reject zero/positive area.  Keep the guard
             * here as a final defense against division by zero. */
            if (area >= int64_t(0))
                continue;
            int64_t e0 = edge(bx, by, cx, cy, int(x), int(y));
            int64_t e1 = edge(cx, cy, ax, ay, int(x), int(y));
            int64_t e2 = edge(ax, ay, bx, by, int(x), int(y));
            if (e0 <= int64_t(0) && e1 <= int64_t(0) && e2 <= int64_t(0)) {
                int64_t weighted = e0 * int64_t(int(stream.words[base + 8u])) +
                    e1 * int64_t(int(stream.words[base + 11u])) +
                    e2 * int64_t(int(stream.words[base + 14u]));
                int candidate = int(weighted / area);
                if (candidate >= depth) {
                    int light = int(stream.words[base + 20u]);
                    if (kind == CMD_VERTEX_LIT_TRIANGLE) {
                        int64_t light_weighted =
                            e0 * int64_t(int(stream.words[base + 20u])) +
                            e1 * int64_t(int(stream.words[base + 22u])) +
                            e2 * int64_t(int(stream.words[base + 23u]));
                        light = int(light_weighted / area);
                    }
                    depth = candidate;
                    if (kind == CMD_TEXTURED_TRIANGLE) {
                        int64_t uoz = e0 * int64_t(int(stream.words[base + 15u])) +
                            e1 * int64_t(int(stream.words[base + 17u])) +
                            e2 * int64_t(int(stream.words[base + 19u]));
                        int64_t voz = e0 * int64_t(int(stream.words[base + 16u])) +
                            e1 * int64_t(int(stream.words[base + 18u])) +
                            e2 * int64_t(int(stream.words[base + 20u]));
                        uint sampled = sample_texture(stream.words[base + 3u],
                            weighted != int64_t(0) ? uoz / weighted : int64_t(0),
                            weighted != int64_t(0) ? voz / weighted : int64_t(0),
                            (stream.words[base + 2u] & FLAG_TEXTURE_REPEAT) != 0u);
                        color = shade(sampled, int(stream.words[base + 21u]),
                                      int(stream.words[base + 22u]));
                    } else {
                        color = shade(stream.words[base + 19u], light,
                                      int(stream.words[base + 21u]));
                    }
                }
            }
        }
    }
    uint index = y * width + x;
    color_out.pixels[index] = color;
    depth_out.values[index] = depth;
}
