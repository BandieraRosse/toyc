uint sky_color(uint q,uint x,uint y,uint w,uint h){int ps=int(stream.words[q+6u]),pc=abs(int(stream.words[q+7u])),f=int(w)*3/4,hor=int(h)/2;if(pc>=64)hor+=clamp(f*ps/pc,-2*int(h),2*int(h));else hor=ps>0?-int(h):2*int(h);if(int(y)>=max(hor,0))return stream.words[q+10u]|0xff000000u;int bot=min(hor,int(h)),bh=bot/8+1,band=clamp(int(y)/bh,0,7);uint c=mix_color(stream.words[q+8u],stream.words[q+9u],7-band,8);const int dx[3]=int[3](340,-872,-488),dy[3]=int[3](248,172,380),dz[3]=int[3](-934,-512,-816),sc[3]=int[3](16,12,10);int ds=int(stream.words[q+4u]),dc=int(stream.words[q+5u]);for(int i=0;i<3;i++){int vx=(dx[i]*dc-dz[i]*ds)/1024,vz0=(dx[i]*ds+dz[i]*dc)/1024,vy2=(dy[i]*int(stream.words[q+7u])-vz0*ps)/1024,vz2=(dy[i]*ps+vz0*int(stream.words[q+7u]))/1024;if(vz2<=64)continue;int cx=int(w)/2+vx*f/vz2,cy=int(h)/2-vy2*f/vz2,u=max(sc[i]/4,2),px=int(x),py=int(y);if(px>=cx-u*7&&px<cx+u*7&&py>=cy+u*2&&py<cy+u*3)c=0xffb9d9ecu;if(px>=cx-u*6&&px<cx+u*6&&py>=cy&&py<cy+u*3)c=0xffeaf7ffu;if(px>=cx-u*3&&px<cx+u*3&&py>=cy-u*2&&py<cy)c=0xffffffffu;if(((px>=cx-u*5&&px<cx-u*3)||(px>=cx+u*3&&px<cx+u*5))&&py>=cy-u&&py<cy)c=0xffffffffu;}return c;}
void main(){uint x=gl_GlobalInvocationID.x,y=gl_GlobalInvocationID.y,width=stream.words[5],height=stream.words[6];if(x>=width||y>=height)return;uint color=0xff000000u;int depth=0;uint count=stream.words[4];for(uint ci=0u;ci<count;ci++){uint base=HEADER_WORDS+ci*COMMAND_WORDS,kind=stream.words[base];if(kind==CMD_SKY)color=sky_color(base,x,y,width,height);else if(kind==CMD_CLEAR_COLOR)color=stream.words[base+4u]|0xff000000u;else if(kind==CMD_CLEAR_DEPTH)depth=int(stream.words[base+4u]);else if(kind==CMD_FLAT_TRIANGLE||kind==CMD_VERTEX_LIT_TRIANGLE||kind==CMD_TEXTURED_TRIANGLE){int ax=int(stream.words[base+6u]),ay=int(stream.words[base+7u]),bx=int(stream.words[base+9u]),by=int(stream.words[base+10u]),cx=int(stream.words[base+12u]),cy=int(stream.words[base+13u]);int minx=kind==CMD_TEXTURED_TRIANGLE?min(ax,min(bx,cx)):int(stream.words[base+15u]),maxx=kind==CMD_TEXTURED_TRIANGLE?max(ax,max(bx,cx))+1:int(stream.words[base+16u]),miny=kind==CMD_TEXTURED_TRIANGLE?min(ay,min(by,cy)):int(stream.words[base+17u]),maxy=kind==CMD_TEXTURED_TRIANGLE?max(ay,max(by,cy))+1:int(stream.words[base+18u]);if(int(x)<minx||int(x)>maxx||int(y)<miny||int(y)>maxy)continue;int64_t area=s64(stream.words[base+4u],stream.words[base+5u]);if(area>=int64_t(0))continue;int64_t e0=edge(bx,by,cx,cy,int(x),int(y)),e1=edge(cx,cy,ax,ay,int(x),int(y)),e2=edge(ax,ay,bx,by,int(x),int(y));if(e0<=int64_t(0)&&e1<=int64_t(0)&&e2<=int64_t(0)){int64_t weighted=e0*int64_t(int(stream.words[base+8u]))+e1*int64_t(int(stream.words[base+11u]))+e2*int64_t(int(stream.words[base+14u]));int candidate=int(weighted/area);if(candidate>=depth){int light=int(stream.words[base+20u]);if(kind==CMD_VERTEX_LIT_TRIANGLE){int64_t light_weighted=e0*int64_t(int(stream.words[base+20u]))+e1*int64_t(int(stream.words[base+22u]))+e2*int64_t(int(stream.words[base+23u]));light=int(light_weighted/area);}depth=candidate;if(kind==CMD_TEXTURED_TRIANGLE){int64_t uoz=e0*int64_t(int(stream.words[base+15u]))+e1*int64_t(int(stream.words[base+17u]))+e2*int64_t(int(stream.words[base+19u])),voz=e0*int64_t(int(stream.words[base+16u]))+e1*int64_t(int(stream.words[base+18u]))+e2*int64_t(int(stream.words[base+20u]));uint sampled=sample_texture(stream.words[base+3u],weighted!=int64_t(0)?uoz/weighted:int64_t(0),weighted!=int64_t(0)?voz/weighted:int64_t(0),(stream.words[base+2u]&FLAG_TEXTURE_REPEAT)!=0u);color=shade(sampled,int(stream.words[base+21u]),int(stream.words[base+22u]));}else color=shade(stream.words[base+19u],light,int(stream.words[base+21u]));}}}}uint index=y*width+x;color_out.pixels[index]=color;depth_out.values[index]=depth;}
