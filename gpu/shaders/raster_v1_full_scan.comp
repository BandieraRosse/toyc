uint texture_byte(uint offset){return(texture_texels.words[offset>>2u]>>((offset&3u)*8u))&255u;}
uint sample_texture(uint handle,int64_t u,int64_t v,bool repeat){uint d=(handle-1u)*6u,offset=texture_descs.words[d],width=texture_descs.words[d+1u],height=texture_descs.words[d+2u],stride=texture_descs.words[d+3u],format=texture_descs.words[d+4u];if(repeat){u&=int64_t(65535);v&=int64_t(65535);}else{u=clamp(u,int64_t(0),int64_t(65535));v=clamp(v,int64_t(0),int64_t(65535));}uint tx=uint((u*int64_t(width))/int64_t(65536)),ty=uint((v*int64_t(height))/int64_t(65536)),channels=format==2u?4u:3u,at=offset+ty*stride+tx*channels;return 0xff000000u|(texture_byte(at)<<16)|(texture_byte(at+1u)<<8)|texture_byte(at+2u);}
int64_t s64(uint low,uint high){return int64_t(uint64_t(low)|(uint64_t(high)<<32));}
int64_t edge(int ax,int ay,int bx,int by,int px,int py){return(int64_t(px)-ax)*(int64_t(by)-ay)-(int64_t(py)-ay)*(int64_t(bx)-ax);}
