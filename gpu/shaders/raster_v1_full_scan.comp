#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#ifndef RF_RASTER_LOCAL_SIZE
#define RF_RASTER_LOCAL_SIZE 16
#endif
layout(local_size_x=RF_RASTER_LOCAL_SIZE,local_size_y=RF_RASTER_LOCAL_SIZE,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer CommandStream{uint words[];}stream;
layout(set=0,binding=1,std430) writeonly buffer ColorBuffer{uint pixels[];}color_out;
layout(set=0,binding=2,std430) writeonly buffer DepthBuffer{int values[];}depth_out;
layout(set=0,binding=5,std430) readonly buffer TextureDescriptors{uint words[];}texture_descs;
layout(set=0,binding=6,std430) readonly buffer TextureTexels{uint words[];}texture_texels;
