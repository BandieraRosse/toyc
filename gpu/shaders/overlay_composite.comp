#version 450

#ifndef RF_RASTER_LOCAL_SIZE
#define RF_RASTER_LOCAL_SIZE 16
#endif

layout(local_size_x = RF_RASTER_LOCAL_SIZE,
       local_size_y = RF_RASTER_LOCAL_SIZE, local_size_z = 1) in;
layout(set=0,binding=0,std430) readonly buffer Header { uint words[]; } header;
layout(set=0,binding=9,std430) buffer WorldColor { uint pixels[]; } world;
layout(set=0,binding=7,std430) readonly buffer OverlayColor { uint pixels[]; } overlay;
layout(set=0,binding=8,std430) readonly buffer OverlayCoverage { uint words[]; } coverage;

void main()
{
    uint x=gl_GlobalInvocationID.x,y=gl_GlobalInvocationID.y;
    uint width=header.words[5],height=header.words[6];
    if(x>=width||y>=height)return;
    uint p=y*width+x;
    uint a=(coverage.words[p>>2u]>>((p&3u)*8u))&255u;
    if(a==0u)return;
    uint src=overlay.pixels[p];
    if(a==255u){world.pixels[p]=src|0xff000000u;return;}
    uint dst=world.pixels[p],inv=255u-a;
    uint r=(((src>>16u)&255u)*a+((dst>>16u)&255u)*inv)/255u;
    uint g=(((src>>8u)&255u)*a+((dst>>8u)&255u)*inv)/255u;
    uint b=((src&255u)*a+(dst&255u)*inv)/255u;
    world.pixels[p]=0xff000000u|(r<<16u)|(g<<8u)|b;
}
